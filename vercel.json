{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "vercel_app.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,frontend/scripts/**,frontend/e2e/**,backend/scripts/**}"
    }
  },
  "crons": [{ "path": "/api/cron/maintenance", "schedule": "0 9 * * *" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}

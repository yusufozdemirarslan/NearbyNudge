{
  "name": "nearbynudge-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "npm run typecheck && vite build && npm run check:urls",
    "typecheck": "tsc -b --noEmit",
    "check:urls": "node scripts/check-urls.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}

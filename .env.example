# ─────────────────────────────────────────────────────────────
# NearbyNudge — configuration template
#
# Copy this file to `.env` and fill in real values. `.env` is
# git-ignored, so your keys never get committed. The n8n workflow
# reads these at runtime via expressions like {{ $env.APIFY_API_TOKEN }}.
# (In n8n, set N8N_BLOCK_ENV_ACCESS_IN_NODE=false to allow $env in
# expressions, and start n8n with these variables in its environment.)
# ─────────────────────────────────────────────────────────────

# Apify API token — Google Maps / Places scraping.
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=your-apify-api-token-here

# Anthropic Claude API key — AI email generation.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Front-end → n8n webhook endpoint.
# Copy your webhook's Production URL and paste it into app/index.html (WEBHOOK_URL).
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/nearbynudge

# Gmail sending uses n8n's Gmail OAuth2 credential (connected inside n8n),
# so there is no key to place here.
